# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Model configuration
RAGBOT_GEMINI_MODEL=gemini-2.5-flash
RAGBOT_GEMINI_EMBEDDING_MODEL=models/text-embedding-004
RAGBOT_EMBEDDING_PROVIDER=sentence-transformer
RAGBOT_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data directory configuration
RAGBOT_DATA_DIR=./data
RAGBOT_RAW_DIR=./data/raw
RAGBOT_INDEX_DIR=./data/index

# Input/output safety configuration
RAGBOT_MAX_INPUT_CHARS=6000
RAGBOT_RETRIEVAL_TOP_K=4

# Arize Phoenix observability configuration
PHOENIX_PROJECT_NAME=ragbot
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# FastAPI server configuration
RAGBOT_HOST=127.0.0.1
RAGBOT_PORT=8000
RAGBOT_RELOAD=false

BATCH_EVALUATION_CRON_ENABLED=false 
BATCH_EVALUATION_CRON_INTERVAL_SECONDS=5
BATCH_EVALUATION_CRON_LIMIT=1000
BATCH_EVALUATION_CRON_SYNC_ANNOTATIONS=true
BATCH_EVALUATION_CRON_SAVE_ANNOTATIONS=true
BATCH_EVALUATION_USE_CHECKPOINT=false
BATCH_EVALUATION_CHECKPOINT_FILE=./data/batch_evaluation/checkpoint.json